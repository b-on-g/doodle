$mol_hotkey2 $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	action *

$mol_hotkey $mol_hotkey2
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
			mod_ctrl <= submit_with_ctrl false
			key * enter? <=> submit? null

$bog_doodle_picker $mol_view
	value? \#1f1d1a
	swatches /string
	sub /
		<= Area $mol_view
			style *
				^
				--bog_doodle_picker_hue <= hue_css \red
			event *
				pointerdown? <=> area_down? null
				pointermove? <=> area_move? null
				pointerup? <=> area_up? null
			sub /
				<= Area_knob $mol_view
					style *
						^
						left <= area_left \0%
						top <= area_top \0%
		<= Hue $mol_view
			event *
				pointerdown? <=> hue_down? null
				pointermove? <=> hue_move? null
				pointerup? <=> hue_up? null
			sub /
				<= Hue_knob $mol_view
					style *
						^
						left <= hue_left \0%
		<= Swatches $mol_view
			sub <= swatch_list /
				<= Swatch* $mol_button_minor
					hint <= swatch_color* \
					click? <=> swatch_pick*? null
					style *
						^
						--bog_doodle_picker_swatch <= swatch_color* \
					sub /
		<= Hex_row $mol_view
			sub /
				<= Preview $mol_view
					style *
						^
						--bog_doodle_picker_swatch <= value? \#1f1d1a
				<= Hex $mol_string
					hint \#rrggbb
					value? <=> hex? \

$mol_ghost $mol_view
	Sub $mol_view

$mol_follower $mol_ghost
	Anchor $mol_view
	align /number
		-.5
		-.5
	offset /number
		0
		0
	style *
		^
		transform <= transform \

$mol_pop $mol_view
	showed? false
	align_vert \
	align_hor \
	direction \ltr
	align_enriched <= align \bottom_center
	prefer \vert
	auto /
		<= bubble null
	sub /
		<= Anchor null
	sub_visible /
		<= Anchor
		<= Follower $mol_follower
			offset <= bubble_offset /number
				0
				1
			align <= bubble_align /number
				0
				0
			Anchor <= Anchor
			Sub <= Bubble $mol_pop_bubble
				content <= bubble_content /$mol_view_content
				height_max <= height_max 9999

$mol_pop_bubble $mol_view
	sub <= content /$mol_view_content
	style *
		^
		maxHeight <= height_max 9999
	attr *
		^
		tabindex 0
		popover \manual

$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$mol_pick $mol_pop
	event *
		^
		keydown? <=> keydown? null
	Anchor <= Trigger $mol_check
		minimal_width 40
		minimal_height 40
		enabled <= trigger_enabled true
		checked? <=> showed?
		clicks? <=> clicks? null
		sub <= trigger_content /$mol_view_content
			<= title
		hint <= hint \

