$mol_theme_auto $mol_plugin
	light \$mol_theme_light
	attr * mol_theme <= theme <= dark \$mol_theme_dark

$mol_image $mol_view
	dom_name \img
	attr *any
		^
		src <= uri \
		title <= hint
		alt <= title \
		loading <= loading \lazy
		decoding <= decoding \async
		crossOrigin <= cors null
		width <= natural_width 0
		height <= natural_height 0
	event *any
		load? <=> load? null
	minimal_width 16
	minimal_height 16

$mol_link $mol_view
	uri \
	dom_name \a
	uri_off \
	uri_native null
	external false
	attr *
		^
		href <= uri_unsafe <= uri_toggle \
		title <= hint_safe <= hint \
		target <= target \_self
		download <= file_name \
		mol_link_current <= current false
		rel <= relation \
	sub /$mol_view_content
		<= title
	arg *
	event *
		^
		click? <=> click? <=> event_click? null

$mol_svg $mol_view
	dom_name \svg
	dom_name_space \http://www.w3.org/2000/svg
	font_size 16
	font_family \
	style_size *

$mol_svg_rect $mol_svg
	dom_name \rect
	pos /
	attr *
		^
		width <= width \0
		height <= height \0
		x <= pos_x \
		y <= pos_y \

$mol_svg_path $mol_svg
	dom_name \path
	attr *
		^
		d <= geometry \


$mol_svg_root $mol_svg
	dom_name \svg
	attr *
		^
		viewBox <= view_box \0 0 100 100
		preserveAspectRatio <= aspect \xMidYMid

$mol_icon $mol_svg_root
	view_box \0 0 24 24
	minimal_width 16
	minimal_height 16
	sub /
		<= Path $mol_svg_path
			geometry <= path \

$mol_icon_music $mol_icon path \M21,3V15.5A3.5,3.5 0 0,1 17.5,19A3.5,3.5 0 0,1 14,15.5A3.5,3.5 0 0,1 17.5,12C18.04,12 18.55,12.12 19,12.34V6.47L9,8.6V17.5A3.5,3.5 0 0,1 5.5,21A3.5,3.5 0 0,1 2,17.5A3.5,3.5 0 0,1 5.5,14C6.04,14 6.55,14.12 7,14.34V6L21,3Z

$mol_icon_music_note $mol_icon path \M12 3V13.55C11.41 13.21 10.73 13 10 13C7.79 13 6 14.79 6 17S7.79 21 10 21 14 19.21 14 17V7H18V3H12Z

$mol_icon_palette $mol_icon path \M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A1.5,1.5 0 0,0 13.5,19.5C13.5,19.11 13.35,18.76 13.11,18.5C12.88,18.23 12.73,17.88 12.73,17.5A1.5,1.5 0 0,1 14.23,16H16A5,5 0 0,0 21,11C21,6.58 16.97,3 12,3Z

$mol_icon_brush $mol_icon path \M20.71,4.63L19.37,3.29C19,2.9 18.35,2.9 17.96,3.29L9,12.25L11.75,15L20.71,6.04C21.1,5.65 21.1,5 20.71,4.63M7,14A3,3 0 0,0 4,17C4,18.31 2.84,19 2,19C2.92,20.22 4.5,21 6,21A4,4 0 0,0 10,17A3,3 0 0,0 7,14Z

$mol_icon_layers $mol_icon path \M12,16L19.36,10.27L21,9L12,2L3,9L4.63,10.27M12,18.54L4.62,12.81L3,14.07L12,21.07L21,14.07L19.37,12.8L12,18.54Z

$mol_icon_tune $mol_icon path \M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z

$mol_icon_cloud $mol_icon path \M6.5 20Q4.22 20 2.61 18.43 1 16.85 1 14.58 1 12.63 2.17 11.1 3.35 9.57 5.25 9.15 5.88 6.85 7.75 5.43 9.63 4 12 4 14.93 4 16.96 6.04 19 8.07 19 11 20.73 11.2 21.86 12.5 23 13.78 23 15.5 23 17.38 21.69 18.69 20.38 20 18.5 20Z

$mol_icon_cloud_off $mol_icon path \M19.8 22.6L17.15 20H6.5Q4.2 20 2.6 18.4T1 14.5Q1 12.58 2.19 11.08 3.38 9.57 5.25 9.15 5.33 8.95 5.4 8.76 5.5 8.57 5.55 8.35L1.4 4.2L2.8 2.8L21.2 21.2M21.6 18.75L8.05 5.23Q8.93 4.63 9.91 4.31 10.9 4 12 4 14.93 4 16.96 6.04 19 8.07 19 11 20.73 11.2 21.86 12.5 23 13.78 23 15.5 23 16.5 22.63 17.31 22.25 18.15 21.6 18.75Z

$mol_icon_cloud_off_outline $mol_icon path \M19.8 22.6L17.15 20H6.5Q4.2 20 2.6 18.4T1 14.5Q1 12.58 2.19 11.08 3.38 9.57 5.25 9.15 5.33 8.95 5.4 8.76 5.5 8.57 5.55 8.35L1.4 4.2L2.8 2.8L21.2 21.2M6.5 18H15.15L7.1 9.95Q7.05 10.23 7.03 10.5 7 10.73 7 11H6.5Q5.05 11 4.03 12.03 3 13.05 3 14.5 3 15.95 4.03 17 5.05 18 6.5 18M11.13 14M21.6 18.75L20.15 17.35Q20.58 17 20.79 16.54 21 16.08 21 15.5 21 14.45 20.27 13.73 19.55 13 18.5 13H17V11Q17 8.93 15.54 7.46 14.08 6 12 6 11.33 6 10.7 6.16 10.07 6.33 9.5 6.68L8.05 5.23Q8.93 4.63 9.91 4.31 10.9 4 12 4 14.93 4 16.96 6.04 19 8.07 19 11 20.73 11.2 21.86 12.5 23 13.78 23 15.5 23 16.5 22.63 17.31 22.25 18.15 21.6 18.75M14.83 12.03Z

$mol_icon_download $mol_icon path \M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z

$mol_icon_share $mol_icon path \M21,12L14,5V9C7,10 4,15 3,20C5.5,16.5 9,14.9 14,14.9V19L21,12Z

$mol_icon_share_variant $mol_icon path \M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z

$bog_doodle_land $mol_view
	title @ \Doodle: draw music
	app_uri \app/
	plugins /
		<= Theme $mol_theme_auto
	sub /
		<= Nav $mol_view
			sub /
				<= Nav_brand $mol_view
					sub /
						<= Nav_logo $mol_image
							uri \bog/doodle/assets/logo.svg
						<= Nav_name $mol_view
							sub /
								\Doodle
				<= Nav_source $mol_link
					uri \https://github.com/b-on-g/doodle
					target \_blank
					title @ \Source code
				<= Nav_open $mol_link
					uri <= app_uri
					title @ \Open the app
		<= Hero $mol_view
			sub /
				<= Hero_text $mol_view
					sub /
						<= Hero_badge $mol_view
							sub /
								<= hero_badge @ \Free forever · no account · works offline
						<= Hero_title $mol_view
							dom_name \h1
							sub /
								<= hero_title @ \Draw a line. Hear a melody.
						<= Hero_lead $mol_view
							dom_name \p
							sub /
								<= hero_lead @ \Doodle turns drawings into music. Every stroke snaps to a scale, every color is an instrument, pen pressure is volume. No notes to learn, no wrong notes to play.
						<= Hero_actions $mol_view
							sub /
								<= Hero_open $mol_link
									uri <= app_uri
									title @ \Start drawing
								<= Hero_how $mol_link
									uri \#how
									title @ \How it works
				<= Art $mol_svg_root
					view_box \0 0 400 300
					aspect \xMidYMid meet
					sub /
						<= Art_sheet $mol_svg_rect
							pos_x \0
							pos_y \0
							width \400
							height \300
						<= Art_grid $mol_svg_path
							geometry \M50 0V300M100 0V300M150 0V300M200 0V300M250 0V300M300 0V300M350 0V300
						<= Art_blue $mol_svg_path
							geometry \M20 230 C 80 230 100 70 170 70 S 260 190 380 170
						<= Art_violet $mol_svg_path
							geometry \M40 110 C 90 60 130 150 190 120 S 280 60 330 100
						<= Art_green $mol_svg_path
							geometry \M30 270 L 370 270
						<= Art_red $mol_svg_path
							geometry \M300 40 l 0 0
						<= Art_head $mol_svg_path
							geometry \M0 0V300
		<= Features $mol_view
			sub /
				<= Features_title $mol_view
					dom_name \h2
					sub /
						<= features_title @ \Everything a paid app has, and then some
				<= Feature_grid $mol_view
					sub /
						<= Feature_music $bog_doodle_land_card
							Icon <= Feature_music_icon $mol_icon_music_note
							head @ \Drawing is music
							text @ \One axis is time, the other is pitch. Lines snap to the notes of the key you picked, so everything sounds right.
						<= Feature_color $bog_doodle_land_card
							Icon <= Feature_color_icon $mol_icon_palette
							head @ \Any color, any voice
							text @ \Pick any color from a full picker. Its hue chooses the instrument: piano, pluck, pad, marimba, lead or bell.
						<= Feature_pen $bog_doodle_land_card
							Icon <= Feature_pen_icon $mol_icon_brush
							head @ \Real drawing tools
							text @ \Pen pressure, smooth strokes, brush and eraser sizes, selection, undo, zoom and pan, palm rejection for tablets.
						<= Feature_layers $bog_doodle_land_card
							Icon <= Feature_layers_icon $mol_icon_layers
							head @ \Layers and patterns
							text @ \Keep bass and melody on separate layers. Chain patterns into verse and chorus and let the editor follow the music.
						<= Feature_moods $bog_doodle_land_card
							Icon <= Feature_moods_icon $mol_icon_tune
							head @ \Moods instead of theory
							text @ \Pick a mood from calm to cyberpunk and the scale, tempo, swing and instrument are set for you.
						<= Feature_offline $bog_doodle_land_card
							Icon <= Feature_offline_icon $mol_icon_cloud_off_outline
							head @ \Works offline
							text @ \Install it to your home screen. Drawings stay on your device, the app runs without a network.
						<= Feature_export $bog_doodle_land_card
							Icon <= Feature_export_icon $mol_icon_download
							head @ \Export for free
							text @ \Save your piece as WAV audio, a MIDI file for your DAW, or a PNG picture. No watermark, no paywall.
						<= Feature_share $bog_doodle_land_card
							Icon <= Feature_share_icon $mol_icon_share_variant
							head @ \Share a link
							text @ \The whole drawing fits into a link. Send it and your friend hears and edits it, no server and no sign up.
		<= Moods $mol_view
			sub /
				<= Moods_title $mol_view
					dom_name \h2
					sub /
						<= moods_title @ \Art comes in every mood
				<= Moods_lead $mol_view
					dom_name \p
					sub /
						<= moods_lead @ \Twenty nine presets, from a lullaby to the avant-garde. One tap and you are in the right key.
				<= Mood_list $mol_view
					sub /
						<= Mood_calm $mol_view
							sub /
								<= mood_calm @ \Calm
						<= Mood_rain $mol_view
							sub /
								<= mood_rain @ \Rain
						<= Mood_space $mol_view
							sub /
								<= mood_space @ \Space
						<= Mood_noir $mol_view
							sub /
								<= mood_noir @ \Noir
						<= Mood_lofi $mol_view
							sub /
								<= mood_lofi @ \Lo-fi
						<= Mood_jazz $mol_view
							sub /
								<= mood_jazz @ \Jazz
						<= Mood_tango $mol_view
							sub /
								<= mood_tango @ \Tango
						<= Mood_celtic $mol_view
							sub /
								<= mood_celtic @ \Celtic
						<= Mood_horror $mol_view
							sub /
								<= mood_horror @ \Horror
						<= Mood_cyber $mol_view
							sub /
								<= mood_cyber @ \Cyberpunk
						<= Mood_impressionism $mol_view
							sub /
								<= mood_impressionism @ \Impressionism
						<= Mood_baroque $mol_view
							sub /
								<= mood_baroque @ \Baroque
						<= Mood_avantgarde $mol_view
							sub /
								<= mood_avantgarde @ \Avant-garde
		<= How $mol_view
			attr *
				^
				id \how
			sub /
				<= How_title $mol_view
					dom_name \h2
					sub /
						<= how_title @ \Three steps to your first song
				<= Steps $mol_view
					sub /
						<= Step_mood $bog_doodle_land_step
							num \1
							head @ \Pick a mood
							text @ \Calm, blues, pixel game or baroque. It sets the key, scale and tempo.
						<= Step_draw $bog_doodle_land_step
							num \2
							head @ \Draw
							text @ \Waves, dots, zigzags. Press harder for louder, change color for a new instrument.
						<= Step_play $bog_doodle_land_step
							num \3
							head @ \Play and share
							text @ \Hit play, stack patterns into a song, export WAV or MIDI, or send a link.
		<= Compare $mol_view
			sub /
				<= Compare_title $mol_view
					dom_name \h2
					sub /
						<= compare_title @ \No subscription. Really.
				<= Compare_table $mol_view
					sub /
						<= Compare_head $bog_doodle_land_row
							name \
							ours @ \Doodle
							theirs @ \Typical paid app
						<= Compare_price $bog_doodle_land_row
							name @ \Price
							ours @ \Free
							theirs @ \Subscription or unlock
						<= Compare_export $bog_doodle_land_row
							name @ \WAV and MIDI export
							ours @ \Yes
							theirs @ \Paid
						<= Compare_colors $bog_doodle_land_row
							name @ \Any color as an instrument
							ours @ \Yes
							theirs @ \Fixed palette
						<= Compare_layers $bog_doodle_land_row
							name @ \Layers, undo, eraser size
							ours @ \Yes
							theirs @ \Rarely
						<= Compare_offline $bog_doodle_land_row
							name @ \Works offline
							ours @ \Yes
							theirs @ \Often not
						<= Compare_account $bog_doodle_land_row
							name @ \Account needed
							ours @ \No
							theirs @ \Often
		<= Faq $mol_view
			sub /
				<= Faq_title $mol_view
					dom_name \h2
					sub /
						<= faq_title @ \Questions
				<= Faq_free $bog_doodle_land_faq
					head @ \Is it really free?
					text @ \Yes. No ads, no subscription, no locked features. The code is open under the MIT license.
				<= Faq_music $bog_doodle_land_faq
					head @ \Do I need to know music theory?
					text @ \No. Pick a mood and draw. The notes always come from the chosen scale, so nothing sounds off.
				<= Faq_devices $bog_doodle_land_faq
					head @ \Which devices does it run on?
					text @ \Any modern browser: phone, tablet with a pen, laptop. Install it from the browser menu to use it like an app.
				<= Faq_data $bog_doodle_land_faq
					head @ \Where are my drawings stored?
					text @ \Only on your device. Nothing is uploaded unless you share a link yourself.
		<= Final $mol_view
			sub /
				<= Final_title $mol_view
					dom_name \h2
					sub /
						<= final_title @ \Your next melody is one line away
				<= Final_open $mol_link
					uri <= app_uri
					title @ \Open Doodle
		<= Foot $mol_view
			sub /
				<= foot_text @ \Doodle is free and open source. MIT license.
				<= Foot_source $mol_link
					uri \https://github.com/b-on-g/doodle
					target \_blank
					title \GitHub

$bog_doodle_land_card $mol_view
	sub /
		<= Icon $mol_icon
		<= Head $mol_view
			dom_name \h3
			sub /
				<= head \
		<= Text $mol_view
			dom_name \p
			sub /
				<= text \

$bog_doodle_land_step $mol_view
	sub /
		<= Num $mol_view
			sub /
				<= num \
		<= Head $mol_view
			dom_name \h3
			sub /
				<= head \
		<= Text $mol_view
			dom_name \p
			sub /
				<= text \

$bog_doodle_land_row $mol_view
	sub /
		<= Name $mol_view
			sub /
				<= name \
		<= Ours $mol_view
			sub /
				<= ours \
		<= Theirs $mol_view
			sub /
				<= theirs \

$bog_doodle_land_faq $mol_view
	dom_name \details
	sub /
		<= Head $mol_view
			dom_name \summary
			sub /
				<= head \
		<= Text $mol_view
			dom_name \p
			sub /
				<= text \
