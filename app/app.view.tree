$bog_doodle_app $mol_view
	title @ \Doodle
	untitled @ \Untitled
	layer_prefix @ \Layer
	voice_names *
		0 @ \Piano
		1 @ \Pluck
		2 @ \Pad
		3 @ \Marimba
		4 @ \Lead
		5 @ \Bell
	vibe_names *
		calm @ \Calm
		sad @ \Sad
		dream @ \Dream
		lullaby @ \Lullaby
		meditation @ \Meditation
		rain @ \Rain
		sunrise @ \Sunrise
		space @ \Space
		fairy @ \Fairy tale
		epic @ \Epic
		blues @ \Blues
		jazz @ \Jazz
		noir @ \Noir
		lofi @ \Lo-fi
		funk @ \Funk
		dance @ \Dance
		rock @ \Rock
		tango @ \Tango
		march @ \March
		medieval @ \Medieval
		celtic @ \Celtic
		east @ \East
		anxiety @ \Anxiety
		horror @ \Horror
		cyber @ \Cyberpunk
		game @ \Pixel game
		impressionism @ \Impressionism
		minimalism @ \Minimalism
		baroque @ \Baroque
		avantgarde @ \Avant-garde
	Store $bog_doodle_gallery
	plugins /
		<= Theme $mol_theme_auto
	auto /
		<= hotkeys null
		<= midi_listen null
	sub /
		<= Bar $mol_view
			sub /
				<= Brand $mol_view
					sub /
						<= title
				<= Title_input $mol_string
					hint @ \Untitled
					value? <=> piece_title? \
				<= Play $mol_button_major
					hint @ \Play or stop (Space)
					click? <=> play_toggle? null
					sub <= play_icon /
						<= Play_icon $mol_icon_play
						<= Stop_icon $mol_icon_stop
				<= Tempo_quick $mol_view
					sub /
						<= Tempo_slider $bog_doodle_slider
							hint @ \Tempo: playback speed
							value? <=> bpm_value? 100
							min 40
							max 220
						<= Tempo_value $mol_view
							sub /
								<= bpm_label \
				<= Undo $mol_button_minor
					hint @ \Undo (Ctrl+Z)
					enabled <= undo_enabled false
					click? <=> undo? null
					sub /
						<= Undo_icon $mol_icon_undo
				<= Redo $mol_button_minor
					hint @ \Redo (Ctrl+Y)
					enabled <= redo_enabled false
					click? <=> redo? null
					sub /
						<= Redo_icon $mol_icon_redo
				<= Gallery_open $mol_check_icon
					hint @ \My drawings
					checked? <=> gallery_opened? false
					Icon <= Gallery_open_icon $mol_icon_folder_music
				<= Layers_open $mol_check_icon
					hint @ \Layers
					checked? <=> layers_opened? false
					Icon <= Layers_open_icon $mol_icon_layers
				<= Settings_open $mol_check_icon
					hint @ \Mood, scale, tempo, export and link
					checked? <=> settings_opened? false
					Icon <= Settings_open_icon $mol_icon_tune
				<= Tools $mol_view
					sub /
						<= Tool_draw $mol_check_icon
							hint @ \Brush (B)
							checked? <=> tool_draw? false
							Icon <= Tool_draw_icon $mol_icon_brush
						<= Tool_erase $mol_check_icon
							hint @ \Eraser (E), right button or pen button
							checked? <=> tool_erase? false
							Icon <= Tool_erase_icon $mol_icon_eraser
						<= Tool_select $mol_check_icon
							hint @ \Select (V): drag a box or tap, then drag
							checked? <=> tool_select? false
							Icon <= Tool_select_icon $mol_icon_cursor_default
						<= Tool_pan $mol_check_icon
							hint @ \Hand (H): move the canvas
							checked? <=> tool_pan? false
							Icon <= Tool_pan_icon $mol_icon_pan
				<= Size $mol_view
					sub <= size_tools /
						<= Brush_size $bog_doodle_slider
							hint @ \Brush size ( [ and ] )
							value? <=> brush_value? 10
							min 2
							max 40
						<= Eraser_size $bog_doodle_slider
							hint @ \Eraser size ( [ and ] )
							value? <=> eraser? 24
							min 6
							max 120
				<= Palette $mol_view
					sub <= palette /
						<= Color* $mol_check
							hint <= color_name* \
							checked? <=> color_checked*? false
							style *
								^
								--bog_doodle_app_ink <= color_ink* \
							sub /
								<= Color_dot* $mol_view
						<= Ink_pick $mol_pick
							hint @ \Any color: the hue picks the instrument
							align_hor \left
							trigger_content /
								<= Ink_dot $mol_view
									style *
										^
										--bog_doodle_app_ink <= ink? \#1f1d1a
								<= Ink_icon $mol_icon_palette
							bubble_content /
								<= Picker $bog_doodle_picker
									value? <=> ink? \#1f1d1a
									swatches <= ink_recent /string
						<= Voice $mol_view
							sub /
								<= voice_name \
				<= Zoom $mol_view
					sub /
						<= Zoom_out $mol_button_minor
							hint @ \Zoom out (−)
							click? <=> zoom_out? null
							sub /
								<= Zoom_out_icon $mol_icon_magnify_minus
						<= Zoom_level $mol_button_minor
							hint @ \Whole loop (0)
							click? <=> zoom_reset? null
							title <= zoom_percent \100%
						<= Zoom_in $mol_button_minor
							hint @ \Zoom in (+)
							click? <=> zoom_in? null
							sub /
								<= Zoom_in_icon $mol_icon_magnify_plus
				<= Selection $mol_view
					sub <= selection_tools /
						<= Select_all $mol_button_minor
							hint @ \Select everything on the layer (Ctrl+A)
							click? <=> select_all? null
							sub /
								<= Select_all_icon $mol_icon_select_all
						<= Copy $mol_button_minor
							hint @ \Duplicate selection (D)
							click? <=> selection_copy? null
							sub /
								<= Copy_icon $mol_icon_content_duplicate
						<= Drop $mol_button_minor
							hint @ \Delete selection (Delete)
							click? <=> selection_drop? null
							sub /
								<= Drop_icon $mol_icon_delete
				<= Patterns $mol_view
					sub <= pattern_tabs /
						<= Pattern* $mol_check
							hint @ \Pattern: a separate loop, patterns can play as a chain
							checked? <=> pattern_checked*? false
							title <= pattern_title* \
						<= Pattern_add $mol_button_minor
							hint @ \New pattern
							click? <=> pattern_add? null
							sub /
								<= Pattern_add_icon $mol_icon_plus
		<= Main $mol_view
			sub <= main /
				<= Board $bog_doodle_board
					sketch <= sketch $bog_doodle_sketch
					notes <= notes /number
					steps <= steps 16
					beat_steps <= beat_steps 2
					bar_steps <= bar_steps 8
					axis <= axis \time_y
					tool? <=> tool? \draw
					ink <= ink? \#1f1d1a
					brush <= brush 1
					eraser <= eraser? 24
					snap <= snap false
					pen_only <= pen_only false
					back <= back \
					layer_order <= layer_order /string
					layer_active <= layer_active? \l1
					layer_default <= layer_default \l1
					layer_focus <= layer_focus? false
					layer_alpha* <= layer_alpha* 1
					blocked <= panel_open false
					unblock? <=> panel_close? null
					selected? <=> selected? /string
					playhead <= playhead null
					playing <= playing false
					note_hover? <=> note_preview? null
				<= Panel $mol_scroll
					sub /
						<= Panel_content $mol_list
							rows <= panel_rows /
	Layers $mol_list
		rows /
			<= Layer_tools $mol_view
				sub /
					<= Layer_add $mol_button_major
						title @ \New layer
						click? <=> layer_add? null
					<= Layer_focus $mol_check_box
						title @ \Dim the others
						checked? <=> layer_focus? false
			<= Layer_name_field $mol_labeler
				title @ \Active layer name
				content /
					<= Layer_name $mol_string
						hint <= layer_name_hint \
						value? <=> layer_name? \
			<= Layer_list $mol_list
				rows <= layer_rows /
					<= Layer* $mol_view
						sub /
							<= Layer_visible* $mol_check_icon
								hint @ \Visible
								checked? <=> layer_visible*? true
								Icon <= Layer_visible_icon* $mol_icon_eye
							<= Layer_pick* $mol_check
								hint @ \Draw on this layer
								checked? <=> layer_picked*? false
								title <= layer_title* \
							<= Layer_opacity* $bog_doodle_slider
								hint @ \Layer opacity
								value? <=> layer_opacity*? 100
								min 0
								max 100
								step 5
							<= Layer_up* $mol_button_minor
								hint @ \Up
								click? <=> layer_up*? null
								sub /
									<= Layer_up_icon* $mol_icon_arrow_up
							<= Layer_down* $mol_button_minor
								hint @ \Down
								click? <=> layer_down*? null
								sub /
									<= Layer_down_icon* $mol_icon_arrow_down
							<= Layer_drop* $mol_button_minor
								hint @ \Delete the layer with all its strokes
								enabled <= layer_drop_enabled false
								click? <=> layer_drop*? null
								sub /
									<= Layer_drop_icon* $mol_icon_delete
	Settings $mol_list
		rows /
			<= Vibe_field $mol_labeler
				title @ \Mood: pick one and scale, tempo and instrument follow
				content /
					<= Vibes $mol_view
						sub <= vibe_list /
							<= Vibe* $mol_check
								title <= vibe_name* \
								checked? <=> vibe_checked*? false
			<= Key_field $mol_labeler
				title @ \Key
				content /
					<= Key_input $mol_select
						value? <=> key_value? \0
						dictionary <= key_options *
			<= Scale_field $mol_labeler
				title @ \Scale
				content /
					<= Scale_input $mol_select
						value? <=> scale_value? \major_penta
						dictionary *
							major_penta @ \Major pentatonic
							minor_penta @ \Minor pentatonic
							major @ \Major
							minor @ \Minor
							harmonic @ \Harmonic minor
							dorian @ \Dorian
							phrygian @ \Phrygian
							lydian @ \Lydian
							mixolydian @ \Mixolydian
							blues @ \Blues
							chromatic @ \Chromatic
			<= Axis_field $mol_labeler
				title @ \Layout
				content /
					<= Axis_input $mol_switch
						value? <=> axis_value? \time_y
						options *
							time_y @ \Notes left to right, time down
							time_x @ \Notes bottom to top, time right
			<= Range_field $mol_labeler
				title @ \Range, octaves
				content /
					<= Range_input $mol_switch
						value? <=> range_value? \2
						options *
							1 \1
							2 \2
							3 \3
			<= Octave_field $mol_labeler
				title @ \Lowest octave
				content /
					<= Octave_input $mol_number
						value? <=> octave_value? 3
						value_min 1
						value_max 6
			<= Tempo_field $mol_labeler
				title @ \Tempo, beats per minute
				content /
					<= Tempo_row $mol_view
						sub /
							<= Tempo_input $mol_number
								value? <=> bpm_value? 100
								value_min 30
								value_max 300
							<= Tap $mol_button_minor
								hint @ \Tap the tempo
								title @ \Tap
								click? <=> tap? null
			<= Bars_field $mol_labeler
				title @ \Bars per pattern
				content /
					<= Bars_input $mol_switch
						value? <=> bars_value? \2
						options *
							1 \1
							2 \2
							4 \4
			<= Grid_field $mol_labeler
				title @ \Quantize
				content /
					<= Grid_input $mol_switch
						value? <=> grid_value? \8
						options *
							4 \1/4
							8 \1/8
							8t @ \1/8t
							16 \1/16
							16t @ \1/16t
							32 \1/32
							free @ \free
			<= Swing_field $mol_labeler
				title @ \Swing
				content /
					<= Swing_input $mol_switch
						value? <=> swing_value? \0
						options *
							0 @ \off
							0.33 @ \light
							0.66 @ \medium
							1 @ \hard
			<= Flags $mol_view
				sub /
					<= Draw_sound_input $mol_check_box
						title @ \Play the note while drawing
						checked? <=> draw_sound? false
					<= Click_input $mol_check_box
						title @ \Metronome
						checked? <=> click? false
					<= Snap_input $mol_check_box
						title @ \Snap to notes
						checked? <=> snap? false
					<= Pen_input $mol_check_box
						title @ \Pen only: fingers move the canvas
						checked? <=> pen_only? false
					<= Chain_input $mol_check_box
						title @ \Play all patterns in a chain
						checked? <=> chain? false
					<= Midi_input $mol_check_box
						title @ \MIDI keyboard
						checked? <=> midi_in? false
			<= Pattern_field $mol_labeler
				title @ \Pattern
				content /
					<= Pattern_tools $mol_view
						sub /
							<= Pattern_copy $mol_button_minor
								title @ \Duplicate
								click? <=> pattern_copy? null
							<= Pattern_clear $mol_button_minor
								title @ \Clear
								click? <=> pattern_clear? null
							<= Pattern_drop $mol_button_minor
								title @ \Delete
								enabled <= pattern_drop_enabled false
								click? <=> pattern_drop? null
			<= Back_field $mol_labeler
				title @ \Background
				content /
					<= Back_tools $mol_view
						sub /
							<= Back_open $mol_button_open
								title @ \Photo
								accept \image/*
								multiple false
								files? <=> back_files? /File
							<= Back_drop $mol_button_minor
								title @ \Remove
								enabled <= back_enabled false
								click? <=> back_drop? null
			<= Export_field $mol_labeler
				title @ \Export
				content /
					<= Export_tools $mol_view
						sub /
							<= Share $mol_button_copy
								title @ \Link
								hint @ \Copy a link to the drawing
								text <= share_link \
							<= Png $mol_button_minor
								title \PNG
								click? <=> export_png? null
							<= Wav $mol_button_minor
								title \WAV
								click? <=> export_wav? null
							<= Midi $mol_button_minor
								title \MIDI
								click? <=> export_midi? null
			<= About $mol_text
				text @ \
					\Draw, and your lines will sound. One axis is time, the other is a note of the chosen scale. The line color is the instrument, pen pressure is the volume.
					\
					\Everything is free, works offline, drawings stay on this device only. [Source code](https://github.com/b-on-g/doodle).
	Gallery $mol_list
		rows <= gallery_rows /
			<= Gallery_new $mol_button_major
				title @ \New drawing
				click? <=> piece_new? null
			<= Piece* $mol_view
				sub /
					<= Piece_open* $mol_button_minor
						click? <=> piece_open*? null
						sub /
							<= Piece_title* $mol_view
								sub /
									<= piece_name* \
							<= Piece_info* $mol_view
								sub /
									<= piece_info* \
					<= Piece_drop* $mol_button_minor
						hint @ \Delete the drawing
						click? <=> piece_drop*? null
						sub /
							<= Piece_drop_icon* $mol_icon_delete
