$bog_doodle_app $mol_view
	title @ \Doodle
	untitled @ \Без названия
	layer_prefix @ \Слой
	Store $bog_doodle_gallery
	plugins /
		<= Theme $mol_theme_auto
	auto /
		<= hotkeys null
		<= midi_listen null
	sub /
		<= Bar $mol_view
			sub /
				<= Brand $mol_view
					sub /
						<= title
				<= Title_input $mol_string
					hint @ \Без названия
					value? <=> piece_title? \
				<= Play $mol_button_major
					hint @ \Играть или стоп (пробел)
					click? <=> play_toggle? null
					sub <= play_icon /
						<= Play_icon $mol_icon_play
						<= Stop_icon $mol_icon_stop
				<= Undo $mol_button_minor
					hint @ \Отменить (Ctrl+Z)
					enabled <= undo_enabled false
					click? <=> undo? null
					sub /
						<= Undo_icon $mol_icon_undo
				<= Redo $mol_button_minor
					hint @ \Вернуть (Ctrl+Y)
					enabled <= redo_enabled false
					click? <=> redo? null
					sub /
						<= Redo_icon $mol_icon_redo
				<= Gallery_open $mol_check_icon
					hint @ \Мои рисунки
					checked? <=> gallery_opened? false
					Icon <= Gallery_open_icon $mol_icon_folder_music
				<= Layers_open $mol_check_icon
					hint @ \Слои
					checked? <=> layers_opened? false
					Icon <= Layers_open_icon $mol_icon_layers
				<= Settings_open $mol_check_icon
					hint @ \Настроение, лад, темп, экспорт и ссылка
					checked? <=> settings_opened? false
					Icon <= Settings_open_icon $mol_icon_tune
				<= Tools $mol_view
					sub /
						<= Tool_draw $mol_check_icon
							hint @ \Кисть (B)
							checked? <=> tool_draw? false
							Icon <= Tool_draw_icon $mol_icon_brush
						<= Tool_erase $mol_check_icon
							hint @ \Ластик (E), правая кнопка или кнопка пера
							checked? <=> tool_erase? false
							Icon <= Tool_erase_icon $mol_icon_eraser
						<= Tool_select $mol_check_icon
							hint @ \Выделение (V): рамкой или касанием, потом тащить
							checked? <=> tool_select? false
							Icon <= Tool_select_icon $mol_icon_cursor_default
						<= Tool_pan $mol_check_icon
							hint @ \Рука (H): двигать холст
							checked? <=> tool_pan? false
							Icon <= Tool_pan_icon $mol_icon_pan
				<= Size $mol_view
					sub <= size_tools /
						<= Brush_size $bog_doodle_slider
							hint @ \Толщина кисти ( [ и ] )
							value? <=> brush_value? 10
							min 2
							max 40
						<= Eraser_size $bog_doodle_slider
							hint @ \Размер ластика ( [ и ] )
							value? <=> eraser? 24
							min 6
							max 120
				<= Palette $mol_view
					sub <= palette /
						<= Color* $mol_check
							hint <= color_name* \
							checked? <=> color_checked*? false
							style *
								^
								--bog_doodle_app_ink <= color_ink* \
							sub /
								<= Color_dot* $mol_view
						<= Ink_pick $mol_pick
							hint @ \Любой цвет: оттенок выбирает инструмент
							align_hor \left
							trigger_content /
								<= Ink_dot $mol_view
									style *
										^
										--bog_doodle_app_ink <= ink? \#1f1d1a
								<= Ink_icon $mol_icon_palette
							bubble_content /
								<= Picker $bog_doodle_picker
									value? <=> ink? \#1f1d1a
									swatches <= ink_recent /string
						<= Voice $mol_view
							sub /
								<= voice_name \
				<= Zoom $mol_view
					sub /
						<= Zoom_out $mol_button_minor
							hint @ \Отдалить (−)
							click? <=> zoom_out? null
							sub /
								<= Zoom_out_icon $mol_icon_magnify_minus
						<= Zoom_level $mol_button_minor
							hint @ \Весь луп (0)
							click? <=> zoom_reset? null
							title <= zoom_percent \100%
						<= Zoom_in $mol_button_minor
							hint @ \Приблизить (+)
							click? <=> zoom_in? null
							sub /
								<= Zoom_in_icon $mol_icon_magnify_plus
				<= Selection $mol_view
					sub <= selection_tools /
						<= Copy $mol_button_minor
							hint @ \Дублировать выделенное (D)
							click? <=> selection_copy? null
							sub /
								<= Copy_icon $mol_icon_content_duplicate
						<= Drop $mol_button_minor
							hint @ \Удалить выделенное (Delete)
							click? <=> selection_drop? null
							sub /
								<= Drop_icon $mol_icon_delete
				<= Patterns $mol_view
					sub <= pattern_tabs /
						<= Pattern* $mol_check
							hint @ \Паттерн: отдельный луп, их можно играть цепочкой
							checked? <=> pattern_checked*? false
							title <= pattern_title* \
						<= Pattern_add $mol_button_minor
							hint @ \Новый паттерн
							click? <=> pattern_add? null
							sub /
								<= Pattern_add_icon $mol_icon_plus
		<= Main $mol_view
			sub <= main /
				<= Board $bog_doodle_board
					sketch <= sketch $bog_doodle_sketch
					notes <= notes /number
					steps <= steps 16
					beat_steps <= beat_steps 2
					bar_steps <= bar_steps 8
					axis <= axis \time_y
					tool? <=> tool? \draw
					ink <= ink? \#1f1d1a
					brush <= brush 1
					eraser <= eraser? 24
					snap <= snap false
					pen_only <= pen_only false
					back <= back \
					layer_order <= layer_order /string
					layer_active <= layer_active? \l1
					layer_default <= layer_default \l1
					layer_focus <= layer_focus? false
					selected? <=> selected? /string
					playhead <= playhead null
					playing <= playing false
					note_hover? <=> note_preview? null
				<= Panel $mol_scroll
					sub /
						<= Panel_content $mol_list
							rows <= panel_rows /
	Layers $mol_list
		rows /
			<= Layer_tools $mol_view
				sub /
					<= Layer_add $mol_button_major
						title @ \Новый слой
						click? <=> layer_add? null
					<= Layer_focus $mol_check_box
						title @ \Приглушать остальные
						checked? <=> layer_focus? false
			<= Layer_name_field $mol_labeler
				title @ \Имя активного слоя
				content /
					<= Layer_name $mol_string
						hint <= layer_name_hint \
						value? <=> layer_name? \
			<= Layer_list $mol_list
				rows <= layer_rows /
					<= Layer* $mol_view
						sub /
							<= Layer_visible* $mol_check_icon
								hint @ \Видно
								checked? <=> layer_visible*? true
								Icon <= Layer_visible_icon* $mol_icon_eye
							<= Layer_pick* $mol_check
								hint @ \Рисовать на этом слое
								checked? <=> layer_picked*? false
								title <= layer_title* \
							<= Layer_up* $mol_button_minor
								hint @ \Выше
								click? <=> layer_up*? null
								sub /
									<= Layer_up_icon* $mol_icon_arrow_up
							<= Layer_down* $mol_button_minor
								hint @ \Ниже
								click? <=> layer_down*? null
								sub /
									<= Layer_down_icon* $mol_icon_arrow_down
							<= Layer_drop* $mol_button_minor
								hint @ \Удалить слой со всеми штрихами
								enabled <= layer_drop_enabled false
								click? <=> layer_drop*? null
								sub /
									<= Layer_drop_icon* $mol_icon_delete
	Settings $mol_list
		rows /
			<= Vibe_field $mol_labeler
				title @ \Настроение: выбери, и лад, темп и инструмент подстроятся
				content /
					<= Vibes $mol_view
						sub <= vibe_list /
							<= Vibe* $mol_check
								title <= vibe_name* \
								checked? <=> vibe_checked*? false
			<= Key_field $mol_labeler
				title @ \Тональность
				content /
					<= Key_input $mol_select
						value? <=> key_value? \0
						dictionary <= key_options *
			<= Scale_field $mol_labeler
				title @ \Лад
				content /
					<= Scale_input $mol_select
						value? <=> scale_value? \major_penta
						dictionary *
							major_penta @ \Мажорная пентатоника
							minor_penta @ \Минорная пентатоника
							major @ \Мажор
							minor @ \Минор
							harmonic @ \Гармонический минор
							dorian @ \Дорийский
							phrygian @ \Фригийский
							lydian @ \Лидийский
							mixolydian @ \Миксолидийский
							blues @ \Блюз
							chromatic @ \Хроматика
			<= Axis_field $mol_labeler
				title @ \Раскладка
				content /
					<= Axis_input $mol_switch
						value? <=> axis_value? \time_y
						options *
							time_y @ \Ноты слева направо, время вниз
							time_x @ \Ноты снизу вверх, время вправо
			<= Range_field $mol_labeler
				title @ \Диапазон, октав
				content /
					<= Range_input $mol_switch
						value? <=> range_value? \2
						options *
							1 \1
							2 \2
							3 \3
			<= Octave_field $mol_labeler
				title @ \Нижняя октава
				content /
					<= Octave_input $mol_number
						value? <=> octave_value? 3
						value_min 1
						value_max 6
			<= Tempo_field $mol_labeler
				title @ \Темп, ударов в минуту
				content /
					<= Tempo_row $mol_view
						sub /
							<= Tempo_input $mol_number
								value? <=> bpm_value? 100
								value_min 30
								value_max 300
							<= Tap $mol_button_minor
								hint @ \Настучать темп
								title @ \Тап
								click? <=> tap? null
			<= Bars_field $mol_labeler
				title @ \Тактов в паттерне
				content /
					<= Bars_input $mol_switch
						value? <=> bars_value? \2
						options *
							1 \1
							2 \2
							4 \4
			<= Grid_field $mol_labeler
				title @ \Квантайз
				content /
					<= Grid_input $mol_switch
						value? <=> grid_value? \8
						options *
							4 \1/4
							8 \1/8
							8t \1/8т
							16 \1/16
							16t \1/16т
							32 \1/32
							free @ \свободно
			<= Swing_field $mol_labeler
				title @ \Свинг
				content /
					<= Swing_input $mol_switch
						value? <=> swing_value? \0
						options *
							0 @ \нет
							0.33 @ \лёгкий
							0.66 @ \средний
							1 @ \жёсткий
			<= Flags $mol_view
				sub /
					<= Draw_sound_input $mol_check_box
						title @ \Играть ноту при рисовании
						checked? <=> draw_sound? false
					<= Click_input $mol_check_box
						title @ \Метроном
						checked? <=> click? false
					<= Snap_input $mol_check_box
						title @ \Липнуть к нотам
						checked? <=> snap? false
					<= Pen_input $mol_check_box
						title @ \Только перо: пальцы двигают холст
						checked? <=> pen_only? false
					<= Chain_input $mol_check_box
						title @ \Играть все паттерны подряд
						checked? <=> chain? false
					<= Midi_input $mol_check_box
						title @ \MIDI-клавиатура
						checked? <=> midi_in? false
			<= Pattern_field $mol_labeler
				title @ \Паттерн
				content /
					<= Pattern_tools $mol_view
						sub /
							<= Pattern_copy $mol_button_minor
								title @ \Дублировать
								click? <=> pattern_copy? null
							<= Pattern_clear $mol_button_minor
								title @ \Очистить
								click? <=> pattern_clear? null
							<= Pattern_drop $mol_button_minor
								title @ \Удалить
								enabled <= pattern_drop_enabled false
								click? <=> pattern_drop? null
			<= Back_field $mol_labeler
				title @ \Фон
				content /
					<= Back_tools $mol_view
						sub /
							<= Back_open $mol_button_open
								title @ \Фото
								accept \image/*
								multiple false
								files? <=> back_files? /File
							<= Back_drop $mol_button_minor
								title @ \Убрать
								enabled <= back_enabled false
								click? <=> back_drop? null
			<= Export_field $mol_labeler
				title @ \Экспорт
				content /
					<= Export_tools $mol_view
						sub /
							<= Share $mol_button_copy
								title @ \Ссылка
								hint @ \Скопировать ссылку на рисунок
								text <= share_link \
							<= Png $mol_button_minor
								title \PNG
								click? <=> export_png? null
							<= Wav $mol_button_minor
								title \WAV
								click? <=> export_wav? null
							<= Midi $mol_button_minor
								title \MIDI
								click? <=> export_midi? null
			<= About $mol_text
				text @ \
					\Рисуй, и линии зазвучат. По горизонтали время, по вертикали нота из выбранного лада. Цвет линии это инструмент, сила нажатия пера это громкость.
					\
					\Всё бесплатно, работает без сети, рисунки хранятся только на этом устройстве. [Исходники](https://github.com/b-on-g/doodle).
	Gallery $mol_list
		rows <= gallery_rows /
			<= Gallery_new $mol_button_major
				title @ \Новый рисунок
				click? <=> piece_new? null
			<= Piece* $mol_view
				sub /
					<= Piece_open* $mol_button_minor
						click? <=> piece_open*? null
						sub /
							<= Piece_title* $mol_view
								sub /
									<= piece_name* \
							<= Piece_info* $mol_view
								sub /
									<= piece_info* \
					<= Piece_drop* $mol_button_minor
						hint @ \Удалить рисунок
						click? <=> piece_drop*? null
						sub /
							<= Piece_drop_icon* $mol_icon_delete
