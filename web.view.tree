			files? <=> files_handled? <=> files? /File
			accept <= accept \
			multiple <= multiple true

$mol_button_open_native $mol_view
	dom_name \input
	files? /File
	attr *
		type \file
		accept <= accept \
		multiple <= multiple true
	event *
		change? <=> picked? null

$mol_icon_clipboard $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3

$mol_icon_clipboard_outline $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7Z

$mol_button_copy $mol_button_minor
	blobs /$mol_blob
		<= text_blob? $mol_blob /
			/BlobPart <= text <= title
			* type \text/plain
		<= html_blob? $mol_blob /
			/BlobPart <= html \
			* type \text/html
	data *
	sub /
		<= Icon $mol_icon_clipboard_outline
		<= title \

$mol_stack $mol_view

$mol_text_code_token $mol_dimmer
	attr *
		^
		mol_text_code_token_type <= type \

$mol_text_code_token_link $mol_text_code_token
	dom_name \a
	type \code-link
	attr *
		^
		href <= uri \
		target \_blank

$mol_text_code_line $mol_paragraph
	text \
	minimal_height 24
	numb_showed true
	syntax null
	uri_resolve* \
	Numb $mol_view
		sub /
			<= numb 0
	Token* $mol_text_code_token
		type <= token_type* \
		haystack <= token_text* \
		needle <= highlight \
	Token_link* $mol_text_code_token_link
		haystack <= token_text* \
		needle <= highlight \
		uri <= token_uri* \
	find_pos* null

$mol_text_code $mol_stack
	attr *
		^
		mol_text_code_sidebar_showed <= sidebar_showed false
	text \
	text_lines /string
	find_pos* null
	uri_base \
	row_themes /string
	sub /
		<= Rows $mol_list
			render_visible_only <= render_visible_only false
			rows <= rows /
				<= Row*0 $mol_text_code_line
					numb_showed <= sidebar_showed
					numb <= row_numb* 0
					theme <= row_theme* \
					text <= row_text* \
					syntax <= syntax null
					uri_resolve* <= uri_resolve* \
					highlight <= highlight \
		<= Copy $mol_button_copy
			hint @ \Copy whole code
			text <= text_export \

$mol_float $mol_view
	style *
		^
		minHeight \auto

$mol_icon_chevron $mol_icon path \M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z

$mol_check_expand $mol_check
	Icon $mol_icon_chevron
	level 0
	style *
		^
		paddingLeft <= level_style \0px
	checked? <=> expanded? false
	enabled <= expandable false

$mol_grid $mol_view
	row_height 32
	row_ids /string[]
	row_id* null
	col_ids /
	records *
	record* null
	hierarchy null
	hierarchy_col \
	minimal_width 0
	-
	sub /
		<= Head
		<= Table $mol_grid_table
			sub <= rows /$mol_view
	Head $mol_grid_row
		cells <= head_cells /$mol_view
	Row* $mol_grid_row
		minimal_height <= row_height
		minimal_width <= minimal_width
		cells <= cells* /$mol_view
	-
	Cell* $mol_view
	cell* null
	Cell_text* $mol_grid_cell
		sub <= cell_content_text* <= cell_content* /$mol_view_content
	Cell_number* $mol_grid_number
		sub <= cell_content_number* <= cell_content* /$mol_view_content
	Col_head* $mol_float
		dom_name \th
		sub <= col_head_content* /$mol_view_content
	Cell_branch* $mol_check_expand
		level <= cell_level* 0
		label <= cell_content* /$mol_view_content
		expanded? <=> cell_expanded*? false
	Cell_content* /
		<= Cell_dimmer* $mol_dimmer
			needle <= needle \
			haystack <= cell_value* \

$mol_grid_table $mol_list
	- dom_name \table

$mol_grid_row $mol_view
	- dom_name \tr
	sub <= cells /$mol_view

$mol_grid_cell $mol_view
	- dom_name \td
	minimal_height 40

$mol_grid_number $mol_grid_cell

$mol_link $mol_view
	uri \
	dom_name \a
	uri_off \
	uri_native null
	external false
	attr *
		^
		href <= uri_unsafe <= uri_toggle \
		title <= hint_safe <= hint \
		target <= target \_self
		download <= file_name \
		mol_link_current <= current false
		rel <= relation \
	sub /$mol_view_content
		<= title
	arg *
	event *
		^
		click? <=> click? <=> event_click? null

$mol_image $mol_view
	dom_name \img
	attr *any
		^
		src <= uri \
		title <= hint
		alt <= title \
		loading <= loading \lazy
		decoding <= decoding \async
		crossOrigin <= cors null
		width <= natural_width 0
		height <= natural_height 0
	event *any
		load? <=> load? null
	minimal_width 16
	minimal_height 16

$mol_link_iconed $mol_link
	sub /
		<= Icon $mol_image
			uri <= icon \
			title \
	content /
		<= title <= uri
	host \

$mol_embed_native $mol_scroll
	dom_name \iframe
	window null
	attr *
		^
		src <= uri? \about:config
	sub /
		<= Fallback $mol_link
			uri <= uri
			sub /
				<= title \
	message *
		hashchange? <=> uri_change? null

$mol_icon_youtube $mol_icon path \M10,15L15.19,12L10,9V15M21.56,7.17C21.69,7.64 21.78,8.27 21.84,9.07C21.91,9.87 21.94,10.56 21.94,11.16L22,12C22,14.19 21.84,15.8 21.56,16.83C21.31,17.73 20.73,18.31 19.83,18.56C19.36,18.69 18.5,18.78 17.18,18.84C15.88,18.91 14.69,18.94 13.59,18.94L12,19C7.81,19 5.2,18.84 4.17,18.56C3.27,18.31 2.69,17.73 2.44,16.83C2.31,16.36 2.22,15.73 2.16,14.93C2.09,14.13 2.06,13.44 2.06,12.84L2,12C2,9.81 2.16,8.2 2.44,7.17C2.69,6.27 3.27,5.69 4.17,5.44C4.64,5.31 5.5,5.22 6.82,5.16C8.12,5.09 9.31,5.06 10.41,5.06L12,5C16.19,5 18.8,5.16 19.83,5.44C20.73,5.69 21.31,6.27 21.56,7.17Z

$mol_frame $mol_embed_native
	attr *
		tabindex <= tabindex
		allow <= allow \
		src <= uri
		srcdoc <= html null
	fullscreen true
	accelerometer true
	autoplay true
	encription true
	gyroscope true
	pip true
	clipboard_read true
	clipboard_write true

$mol_embed_service $mol_check
	uri \
	video_preview \
	video_id \
	checked? <=> active? false
	sub /
		<= Image $mol_image
			title <= title \
			uri <= video_preview \
		<= Hint $mol_icon_youtube
		<= Frame $mol_frame
			title <= title \
			uri <= video_embed \


$mol_embed_youtube $mol_embed_service

$mol_embed_rutube $mol_embed_service

$mol_embed_vklive $mol_embed_service

$mol_embed_any $mol_view
	Image $mol_image
		title <= title \
		uri <= uri \
	Object $mol_embed_native
		title <= title \
		uri <= uri \
	Youtube $mol_embed_youtube
		title <= title \
		uri <= uri \
	Rutube $mol_embed_rutube
		title <= title \
		uri <= uri \
	Vklive $mol_embed_vklive
		title <= title \
		uri <= uri \

$mol_expander $mol_list
	rows /
		<= Label $mol_view
			sub /
				<= Trigger $mol_check_expand
					checked? <=> expanded? false
					expandable <= expandable true
					label <= label /
						<= title
				<= Tools null
		<= Content $mol_list
			rows <= content /

$mol_text $mol_list
	uri_base \
	text \
	param \
	flow_tokens /
	block_text* \
	auto /
		<= auto_scroll null
	- \Blocks
	Paragraph* $mol_paragraph
		sub <= block_content* /
	Quote* $mol_text
		uri_resolve* <= uri_resolve* \
		text <= quote_text* \
		highlight <= highlight \
		auto_scroll null
	List* $mol_text_list
		uri_resolve* <= uri_resolve* \
		type <= list_type* \-
		text <= list_text* \
		highlight <= highlight \
	item_index* 0
	Header* $mol_text_header
		minimal_height 40
		level <= header_level* 1
		content <= block_content* /
		arg <= header_arg* *
	Pre* $mol_text_code
		text <= pre_text* \
		row_themes <= pre_themes* /string
		highlight <= highlight \
		uri_resolve* <= uri_resolve* \
		sidebar_showed <= pre_sidebar_showed <= code_sidebar_showed true
	Cut* $mol_view dom_name \hr
	- \Table
	Table* $mol_grid
		head_cells <= table_head_cells* /
		rows <= table_rows* /
	Table_row* $mol_grid_row
		cells <= table_cells* /
	Table_cell* $mol_text
		auto_scroll null
		highlight <= highlight \
		uri_resolve* <= uri_resolve* \
		text <= table_cell_text* \
	- \Grid
	Grid* $mol_grid
		rows <= grid_rows* /
	Grid_row* $mol_grid_row
		cells <= grid_cells* /
	Grid_cell* $mol_text
		auto_scroll null
		highlight <= highlight \
		uri_resolve* <= uri_resolve* \
		text <= grid_cell_text* \
	- \Lines
	String* $mol_dimmer
		dom_name \span
		needle <= highlight \
		haystack <= line_text* \
	Span* $mol_text_span
		dom_name \span
		type <= line_type* \
		sub <= line_content* /
	Code_line* $mol_text_code_line
		numb_showed false
		highlight <= highlight \
		text <= line_text* \
		uri_resolve* <= uri_resolve* \
		syntax <= code_syntax null
	Link* $mol_link_iconed
		uri <= link_uri* \
		content <= line_content* /
	Link_http* $mol_link_iconed
		uri <= link_uri* \
		content / <= link_host* \
	Embed* $mol_embed_any
		uri <= link_uri* \
		title <= line_text* \
	- \Spoilers
	Spoiler* $mol_expander
		label /
			<= Spoiler_label* $mol_text
				text <= spoiler_label* \
		content /
			<= Spoiler_content* $mol_text
				text <= spoiler_content* \

$mol_text_header $mol_paragraph
	level 1
	sub /
		<= Link $mol_link
			arg <= arg *
			hint @ \Permalink to this section
			sub <= content /

$mol_text_span $mol_paragraph
	dom_name \span
	attr *
		^
		mol_text_type <= type \

$mol_text_list $mol_text
	auto_scroll null
	attr *
		^
		mol_text_list_type <= type \
	Paragraph* $mol_text_list_item
		index <= item_index*
		sub <= block_content*

$mol_text_list_item $mol_paragraph
	attr *
		^
		mol_text_list_item_index <= index 0

$bog_doodle_app $mol_view
	title @ \Doodle
	untitled @ \Без названия
	layer_prefix @ \Слой
	Store $bog_doodle_gallery
	plugins /
		<= Theme $mol_theme_auto
	auto /
		<= hotkeys null
		<= midi_listen null
	sub /
		<= Bar $mol_view
			sub /
				<= Brand $mol_view
					sub /
						<= title
				<= Play $mol_button_major
					hint @ \Играть или стоп (пробел)
					click? <=> play_toggle? null
					sub <= play_icon /
						<= Play_icon $mol_icon_play
						<= Stop_icon $mol_icon_stop
				<= Undo $mol_button_minor
					hint @ \Отменить (Ctrl+Z)
					enabled <= undo_enabled false
					click? <=> undo? null
					sub /
						<= Undo_icon $mol_icon_undo
				<= Redo $mol_button_minor
					hint @ \Вернуть (Ctrl+Y)
					enabled <= redo_enabled false
					click? <=> redo? null
					sub /
						<= Redo_icon $mol_icon_redo
				<= Gallery_open $mol_check_icon
					hint @ \Мои рисунки
					checked? <=> gallery_opened? false
					Icon <= Gallery_open_icon $mol_icon_folder_music
				<= Layers_open $mol_check_icon
					hint @ \Слои
					checked? <=> layers_opened? false
					Icon <= Layers_open_icon $mol_icon_layers
				<= Settings_open $mol_check_icon
					hint @ \Настроение, лад, темп, экспорт и ссылка
					checked? <=> settings_opened? false
					Icon <= Settings_open_icon $mol_icon_tune
				<= Tools $mol_view
					sub /
						<= Tool_draw $mol_check_icon
							hint @ \Кисть (B)
							checked? <=> tool_draw? false
							Icon <= Tool_draw_icon $mol_icon_brush
						<= Tool_erase $mol_check_icon
							hint @ \Ластик (E), правая кнопка или кнопка пера
							checked? <=> tool_erase? false
							Icon <= Tool_erase_icon $mol_icon_eraser
						<= Tool_select $mol_check_icon
							hint @ \Выделение (V): рамкой или касанием, потом тащить
							checked? <=> tool_select? false
							Icon <= Tool_select_icon $mol_icon_cursor_default
						<= Tool_pan $mol_check_icon
							hint @ \Рука (H): двигать холст
							checked? <=> tool_pan? false
							Icon <= Tool_pan_icon $mol_icon_pan
				<= Size $mol_view
					sub <= size_tools /
						<= Brush_size $bog_doodle_slider
							hint @ \Толщина кисти ( [ и ] )
							value? <=> brush_value? 10
							min 2
							max 40
						<= Eraser_size $bog_doodle_slider
							hint @ \Размер ластика ( [ и ] )
							value? <=> eraser? 24
							min 6
							max 120
				<= Palette $mol_view
					sub <= palette /
						<= Color* $mol_check
							hint <= color_name* \
							checked? <=> color_checked*? false
							style *
								^
								--bog_doodle_app_ink <= color_ink* \
							sub /
								<= Color_dot* $mol_view
						<= Ink_pick $mol_pick
							hint @ \Любой цвет: оттенок выбирает инструмент
							align_hor \left
							trigger_content /
								<= Ink_dot $mol_view
									style *
										^
										--bog_doodle_app_ink <= ink? \#1f1d1a
								<= Ink_icon $mol_icon_palette
							bubble_content /
								<= Picker $bog_doodle_picker
									value? <=> ink? \#1f1d1a
									swatches <= ink_recent /string
						<= Voice $mol_view
							sub /
								<= voice_name \
				<= Zoom $mol_view
					sub /
						<= Zoom_out $mol_button_minor
							hint @ \Отдалить (−)
							click? <=> zoom_out? null
							sub /
								<= Zoom_out_icon $mol_icon_magnify_minus
						<= Zoom_level $mol_button_minor
							hint @ \Весь луп (0)
							click? <=> zoom_reset? null
							title <= zoom_percent \100%
						<= Zoom_in $mol_button_minor
							hint @ \Приблизить (+)
							click? <=> zoom_in? null
							sub /
								<= Zoom_in_icon $mol_icon_magnify_plus
				<= Selection $mol_view
					sub <= selection_tools /
						<= Copy $mol_button_minor
							hint @ \Дублировать выделенное (D)
							click? <=> selection_copy? null
							sub /
								<= Copy_icon $mol_icon_content_duplicate
						<= Drop $mol_button_minor
							hint @ \Удалить выделенное (Delete)
							click? <=> selection_drop? null
							sub /
								<= Drop_icon $mol_icon_delete
				<= Patterns $mol_view
					sub <= pattern_tabs /
						<= Pattern* $mol_check
							hint @ \Паттерн: отдельный луп, их можно играть цепочкой
							checked? <=> pattern_checked*? false
							title <= pattern_title* \
						<= Pattern_add $mol_button_minor
							hint @ \Новый паттерн
							click? <=> pattern_add? null
							sub /
								<= Pattern_add_icon $mol_icon_plus
		<= Main $mol_view
			sub <= main /
				<= Board $bog_doodle_board
					sketch <= sketch $bog_doodle_sketch
					notes <= notes /number
					steps <= steps 16
					beat_steps <= beat_steps 2
					bar_steps <= bar_steps 8
					axis <= axis \time_y
					tool? <=> tool? \draw
					ink <= ink? \#1f1d1a
					brush <= brush 1
					eraser <= eraser? 24
					snap <= snap false
					pen_only <= pen_only false
					back <= back \
					layer_order <= layer_order /string
					layer_active <= layer_active? \l1
					layer_default <= layer_default \l1
					layer_focus <= layer_focus? false
					selected? <=> selected? /string
					playhead <= playhead null
					playing <= playing false
					note_hover? <=> note_preview? null
				<= Panel $mol_scroll
					sub /
						<= Panel_content $mol_list
							rows <= panel_rows /
	Layers $mol_list
		rows /
			<= Layer_tools $mol_view
				sub /
					<= Layer_add $mol_button_major
						title @ \Новый слой
						click? <=> layer_add? null
					<= Layer_focus $mol_check_box
						title @ \Приглушать остальные
						checked? <=> layer_focus? false
			<= Layer_name_field $mol_labeler
				title @ \Имя активного слоя
				content /
					<= Layer_name $mol_string
						hint <= layer_name_hint \
						value? <=> layer_name? \
			<= Layer_list $mol_list
				rows <= layer_rows /
					<= Layer* $mol_view
						sub /
							<= Layer_visible* $mol_check_icon
								hint @ \Видно
								checked? <=> layer_visible*? true
								Icon <= Layer_visible_icon* $mol_icon_eye
							<= Layer_audible* $mol_check_icon
								hint @ \Звучит
								checked? <=> layer_audible*? true
								Icon <= Layer_audible_icon* $mol_icon_volume_high
							<= Layer_pick* $mol_check
								hint @ \Рисовать на этом слое
								checked? <=> layer_picked*? false
								title <= layer_title* \
							<= Layer_up* $mol_button_minor
								hint @ \Выше
								click? <=> layer_up*? null
								sub /
									<= Layer_up_icon* $mol_icon_arrow_up
							<= Layer_down* $mol_button_minor
								hint @ \Ниже
								click? <=> layer_down*? null
								sub /
									<= Layer_down_icon* $mol_icon_arrow_down
							<= Layer_drop* $mol_button_minor
								hint @ \Удалить слой со всеми штрихами
								enabled <= layer_drop_enabled false
								click? <=> layer_drop*? null
								sub /
									<= Layer_drop_icon* $mol_icon_delete
	Settings $mol_list
		rows /
			<= Vibe_field $mol_labeler
				title @ \Настроение: выбери, и лад, темп и инструмент подстроятся
				content /
					<= Vibes $mol_view
						sub <= vibe_list /
							<= Vibe* $mol_check
								title <= vibe_name* \
								checked? <=> vibe_checked*? false
			<= Title_field $mol_labeler
				title @ \Название
				content /
					<= Title_input $mol_string
						hint @ \Без названия
						value? <=> piece_title? \
			<= Key_field $mol_labeler
				title @ \Тональность
				content /
					<= Key_input $mol_select
						value? <=> key_value? \0
						dictionary <= key_options *
			<= Scale_field $mol_labeler
				title @ \Лад
				content /
					<= Scale_input $mol_select
						value? <=> scale_value? \major_penta
						dictionary *
							major_penta @ \Мажорная пентатоника
							minor_penta @ \Минорная пентатоника
							major @ \Мажор
							minor @ \Минор
							harmonic @ \Гармонический минор
							dorian @ \Дорийский
							phrygian @ \Фригийский
							lydian @ \Лидийский
							mixolydian @ \Миксолидийский
							blues @ \Блюз
							chromatic @ \Хроматика
			<= Axis_field $mol_labeler
				title @ \Раскладка
				content /
					<= Axis_input $mol_switch
						value? <=> axis_value? \time_y
						options *
							time_y @ \Ноты слева направо, время вниз
							time_x @ \Ноты снизу вверх, время вправо
			<= Range_field $mol_labeler
				title @ \Диапазон, октав
				content /
					<= Range_input $mol_switch
						value? <=> range_value? \2
						options *
							1 \1
							2 \2
							3 \3
			<= Octave_field $mol_labeler
				title @ \Нижняя октава
				content /
					<= Octave_input $mol_number
						value? <=> octave_value? 3
						value_min 1
						value_max 6
			<= Tempo_field $mol_labeler
				title @ \Темп, ударов в минуту
				content /
					<= Tempo_row $mol_view
						sub /
							<= Tempo_input $mol_number
								value? <=> bpm_value? 100
								value_min 30
								value_max 300
							<= Tap $mol_button_minor
								hint @ \Настучать темп
								title @ \Тап
								click? <=> tap? null
			<= Bars_field $mol_labeler
				title @ \Тактов в паттерне
				content /
					<= Bars_input $mol_switch
						value? <=> bars_value? \2
						options *
							1 \1
							2 \2
							4 \4
			<= Grid_field $mol_labeler
				title @ \Квантайз
				content /
					<= Grid_input $mol_switch
						value? <=> grid_value? \8
						options *
							4 \1/4
							8 \1/8
							8t \1/8т
							16 \1/16
							16t \1/16т
							32 \1/32
							free @ \свободно
			<= Swing_field $mol_labeler
				title @ \Свинг
				content /
					<= Swing_input $mol_switch
						value? <=> swing_value? \0
						options *
							0 @ \нет
							0.33 @ \лёгкий
							0.66 @ \средний
							1 @ \жёсткий
			<= Flags $mol_view
				sub /
					<= Draw_sound_input $mol_check_box
						title @ \Играть ноту при рисовании
						checked? <=> draw_sound? false
					<= Click_input $mol_check_box
						title @ \Метроном
						checked? <=> click? false
					<= Snap_input $mol_check_box
						title @ \Липнуть к нотам
						checked? <=> snap? false
					<= Pen_input $mol_check_box
						title @ \Только перо: пальцы двигают холст
						checked? <=> pen_only? false
					<= Chain_input $mol_check_box
						title @ \Играть все паттерны подряд
						checked? <=> chain? false
					<= Midi_input $mol_check_box
						title @ \MIDI-клавиатура
						checked? <=> midi_in? false
			<= Pattern_field $mol_labeler
				title @ \Паттерн
				content /
					<= Pattern_tools $mol_view
						sub /
							<= Pattern_copy $mol_button_minor
								title @ \Дублировать
								click? <=> pattern_copy? null
							<= Pattern_clear $mol_button_minor
								title @ \Очистить
								click? <=> pattern_clear? null
							<= Pattern_drop $mol_button_minor
								title @ \Удалить
								enabled <= pattern_drop_enabled false
								click? <=> pattern_drop? null
			<= Back_field $mol_labeler
				title @ \Фон
				content /
					<= Back_tools $mol_view
						sub /
							<= Back_open $mol_button_open
								title @ \Фото
								accept \image/*
								multiple false
								files? <=> back_files? /File
							<= Back_drop $mol_button_minor
								title @ \Убрать
								enabled <= back_enabled false
								click? <=> back_drop? null
			<= Export_field $mol_labeler
				title @ \Экспорт
				content /
					<= Export_tools $mol_view
						sub /
							<= Share $mol_button_copy
								title @ \Ссылка
								hint @ \Скопировать ссылку на рисунок
								text <= share_link \
							<= Png $mol_button_minor
								title \PNG
								click? <=> export_png? null
							<= Wav $mol_button_minor
								title \WAV
								click? <=> export_wav? null
							<= Midi $mol_button_minor
								title \MIDI
								click? <=> export_midi? null
			<= About $mol_text
				text @ \
					\Рисуй, и линии зазвучат. По горизонтали время, по вертикали нота из выбранного лада. Цвет линии это инструмент, сила нажатия пера это громкость.
					\
					\Всё бесплатно, работает без сети, рисунки хранятся только на этом устройстве. [Исходники](https://github.com/b-on-g/doodle).
	Gallery $mol_list
		rows <= gallery_rows /
			<= Gallery_new $mol_button_major
				title @ \Новый рисунок
				click? <=> piece_new? null
			<= Piece* $mol_view
				sub /
					<= Piece_open* $mol_button_minor
						click? <=> piece_open*? null
						sub /
							<= Piece_title* $mol_view
								sub /
									<= piece_name* \
							<= Piece_info* $mol_view
								sub /
									<= piece_info* \
					<= Piece_drop* $mol_button_minor
						hint @ \Удалить рисунок
						click? <=> piece_drop*? null
						sub /
							<= Piece_drop_icon* $mol_icon_delete

